# Everything not needed at runtime — the bundle ships the self-contained dist/.
.git/
.github/
node_modules/
src/
scripts/
dist-tests/
docs/
coverage/

# Agent/contributor tooling — dev-only, irrelevant to an installed extension.
# .agents/skills and .claude/skills are symlinks to skills/; mcpb pack
# resolves symlinks to real files, so without these the same 7 files were
# shipping three times over.
.claude/
.agents/
skills/
AGENTS.md
CLAUDE.md
SECURITY.md
# Glama.ai directory metadata (maintainer GitHub usernames) — read by
# Glama's crawler from the repo/npm page, not needed by an installed
# extension at runtime.
glama.json

# Tooling / config
tsconfig.json
tsup.config.ts
eslint.config.js
.prettierrc.json
.gitattributes
.nvmrc
.gitignore
.mcpbignore
.editorconfig
.env
.env.*

# Tests & sourcemaps
**/*.test.*
**/*.map

# Icon regeneration source (dev-only, needs Python/Pillow — not runtime
# assets). manifest.json's icon field only needs assets/icon.png, which
# stays included.
assets/icon-source.svg
assets/generate-icon.py

# OS
.DS_Store
