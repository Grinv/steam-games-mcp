{
  "name": "steam-games-mcp",
  "version": "0.16.0",
  "mcpName": "io.github.Grinv/steam-games-mcp",
  "description": "Enables LLMs to search and evaluate Steam games — prices, discounts, reviews and Steam Deck compatibility with no API key, plus a player's library, achievements and friends via the official Steam Web API.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Grinv",
    "email": "4070730+Grinv@users.noreply.github.com",
    "url": "https://github.com/Grinv"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "steam",
    "steamworks",
    "games"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grinv/steam-games-mcp.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "steam-games-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "test": "node scripts/run-tests.ts",
    "test:coverage": "node scripts/run-tests.ts --coverage",
    "preversion": "node scripts/preversion-check.ts",
    "version": "node scripts/sync-version.ts && git add src/version.ts manifest.json server.json CHANGELOG.md",
    "lint": "eslint .",
    "check:api": "node scripts/check-api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
